{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "Python: Run backrooms.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backrooms.py",
            "args": ["--lm", "o1-preview", "o1-preview", "--template", "student"],
            "console": "integratedTerminal"
        }
        ,
        {
            "name": "Python: CLI with World Interface",
            "type": "debugpy", 
            "request": "launch",
            "program": "${workspaceFolder}/backrooms.py",
            "args": ["--lm", "opus", "cli", "--template", "cli_with_world_interface"],
            "console": "integratedTerminal"
        }
    ]
}